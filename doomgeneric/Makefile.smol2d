################################################################
#
# Makefile for the smol2d platform: a static nolibc binary that
# renders through smol2d's drm backend. Point it at your checkouts:
#
#    make -f Makefile.smol2d \
#        NOLIBCDIR=path/to/linux/tools/include/nolibc \
#        SMOL2DDIR=path/to/smol2d
#
# smol2d must have been built with the same NOLIBCDIR first, for
# libsmol2ddrm_nolibc.a.
#

ifndef NOLIBCDIR
$(error Please pass NOLIBCDIR with the path to your copy of nolibc (tools/include/nolibc/ in the linux source))
endif

ifndef SMOL2DDIR
$(error Please pass SMOL2DDIR with the path to your copy of smol2d)
endif

ifeq ($(V),1)
	VB=''
else
	VB=@
endif

# -nostdinc so that <stdio.h> and friends are nolibc's and not the
# host libc's; compat-nolibc carries the few calls nolibc lacks, and
# /usr/include comes last for the linux uapi headers nolibc itself
# wants, ranked below nolibc so none of libc's headers shadow it.
CFLAGS+=-ggdb3 -Os -Wall \
	-nostdinc -nostdlib \
	-Icompat-nolibc -I$(NOLIBCDIR) -I$(SMOL2DDIR)/include \
	-isystem /usr/include/$(shell $(CC) -print-multiarch) \
	-isystem /usr/include \
	-include $(NOLIBCDIR)/nolibc.h \
	-include compat-nolibc/nolibc-compat.h \
	-DCMAP256 -DDOOMGENERIC_RESX=640 -DDOOMGENERIC_RESY=400 \
	-DNORMALUNIX -DLINUX
LDFLAGS+=-nostdlib -static -Wl,--gc-sections -Wl,--hash-style=gnu
LIBS+=$(SMOL2DDIR)/libsmol2ddrm/libsmol2ddrm_nolibc.a -lgcc

OBJDIR=build_smol2d
OUTPUT=doomgeneric_smol2d

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_smol2d.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all:	 $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)
	rm -f $(OUTPUT).map

$(OUTPUT):	$(OBJS)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) \
	-o $(OUTPUT) $(LIBS) -Wl,-Map,$(OUTPUT).map
	@echo [Size]
	-size $(OUTPUT)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o:	%.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)
